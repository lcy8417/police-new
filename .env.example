# 이 파일을 복사해 `.env`로 저장한 뒤 값을 채우세요:  copy .env.example .env

# 백엔드 주소. 비우면 같은 주소로 중계(권장) — 브라우저는 프론트 주소 하나만 보고,
# Vite 개발/미리보기 서버가 API·이미지 요청을 아래 VITE_PROXY_TARGET으로 넘긴다
# (로그인 쿠키가 막히지 않고 CORS 설정도 필요 없음).
# 주소를 분리하려면 https://<서버주소>:8000 을 넣고, 서버 .env에 COOKIE_SAMESITE=none·COOKIE_SECURE=true 필요.
VITE_API_URL=

# 중계 대상(police-server FastAPI 주소). 자체 서명 인증서여도 된다.
VITE_PROXY_TARGET=https://localhost:8000
