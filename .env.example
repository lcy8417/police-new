# 이 파일을 복사해 `.env`로 저장한 뒤 값을 채우세요:  copy .env.example .env

# 백엔드 주소. 비우면 같은 주소로 중계(권장) — 브라우저는 프론트 주소 하나만 보고,
# Vite 개발/미리보기 서버가 API·이미지 요청을 아래 VITE_PROXY_TARGET으로 넘긴다
# (로그인 쿠키가 막히지 않고 CORS 설정도 필요 없음).
# 주소를 분리하려면 https://<서버주소>:8000 을 넣고, 서버 .env에 COOKIE_SAMESITE=none·COOKIE_SECURE=true 필요.
VITE_API_URL=

# 중계 대상(police-server FastAPI 주소). 자체 서명 인증서여도 된다. 서버를 http:// 로 켰으면 http://…
# 개발(npm run dev) · 운영(npm run build 뒤 npx vite preview --host --port 5173) 모두 이 값으로 중계한다(README「실행」).
# 서버가 그림을 어느 폴더에 두든(서버 .env 의 POLICE_DATA_ROOT 등) 그림 주소는 같으므로 여기는 바꾸지 않는다.
VITE_PROXY_TARGET=https://localhost:8000

# 화면을 https:// 로 열 때(운영 권장 — 서버 .env 의 COOKIE_SECURE=true 와 짝). 둘 다 적으면 dev · preview 서버가 HTTPS 로 뜬다.
# 비우면 http(개발용). 경로는 이 폴더 기준 — 서버가 쓰는 자체 서명 인증서를 그대로 가리켜도 된다.
# HTTPS_CERT_FILE=../police-server/cert.pem
# HTTPS_KEY_FILE=../police-server/key.pem
